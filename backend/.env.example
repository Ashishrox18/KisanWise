# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage backend ──────────────────────────────────────────────────────────
# Use Neon PostgreSQL (recommended for production)
USE_POSTGRES=true
USE_LOCAL_STORAGE=false

# Neon PostgreSQL - get from https://neon.tech dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# DynamoDB-style table names (used as Postgres table names)
DYNAMODB_USERS_TABLE=krishi-users
DYNAMODB_CROPS_TABLE=krishi-crops
DYNAMODB_ORDERS_TABLE=krishi-orders
DYNAMODB_SHIPMENTS_TABLE=krishi-shipments
DYNAMODB_STORAGE_TABLE=krishi-storage
DYNAMODB_TRANSACTIONS_TABLE=krishi-transactions
DYNAMODB_NOTIFICATIONS_TABLE=krishi-notifications

# AI - Groq (free tier at https://console.groq.com)
USE_GROQ=true
GROQ_API_KEY=your_groq_api_key_here

# AWS (not used - kept to prevent SDK init errors)
USE_SES=false
USE_BEDROCK=false
USE_SNS=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy-not-used
AWS_SECRET_ACCESS_KEY=dummy-not-used

# Market prices (optional - free tier)
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# ML price-trend predictor (XGBoost, additive signal for the Scenario Mapper).
# OFF by default — train the model first (backend/ml/train.py), then set to true.
# PYTHON_PATH overrides the python binary if `python` vs `python3` differs.
ENABLE_ML_PRICE_PREDICTOR=false
PYTHON_PATH=python3
# macOS only: xgboost needs the OpenMP runtime (libomp). If libomp isn't on the
# system rpath (e.g. no Homebrew), set DYLD_LIBRARY_PATH to the dir containing
# libomp.dylib (often your venv's xgboost lib dir). Leave empty on Linux or where
# libomp is already resolvable. The spawned python inherits this at runtime.
# DYLD_LIBRARY_PATH=/path/to/venv/lib/python3.x/site-packages/xgboost/lib
