{
  "name": "krishi-era-backend",
  "version": "1.0.0",
  "description": "Backend API for Krishi Era AI Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint . --ext .ts",
    "setup-dynamodb": "ts-node scripts/setup-dynamodb.ts",
    "setup-ses": "ts-node scripts/setup-ses.ts",
    "auto-setup-ses": "ts-node scripts/auto-setup-ses.ts",
    "verify-email": "ts-node scripts/verify-email.ts",
    "test:ses": "ts-node scripts/test-ses.ts",
    "test:registration": "ts-node scripts/test-registration.ts",
    "request-production": "ts-node scripts/request-production-access.ts",
    "seed": "ts-node scripts/seed-users.ts",
    "auth:earth-engine": "ts-node scripts/auth-earth-engine.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.515.0",
    "@aws-sdk/client-dynamodb": "^3.515.0",
    "@aws-sdk/client-iam": "^3.1004.0",
    "@aws-sdk/client-iot": "^3.515.0",
    "@aws-sdk/client-location": "^3.515.0",
    "@aws-sdk/client-rekognition": "^3.515.0",
    "@aws-sdk/client-s3": "^3.515.0",
    "@aws-sdk/client-ses": "^3.1004.0",
    "@aws-sdk/client-sns": "^3.515.0",
    "@aws-sdk/client-sqs": "^3.515.0",
    "@aws-sdk/lib-dynamodb": "^3.515.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@google-cloud/bigquery": "^9.3.0",
    "@google/earthengine": "^1.7.48",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "7.5.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.16",
    "@types/supertest": "6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "jest": "29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
